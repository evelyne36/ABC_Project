{
  "description": "Default Random500 search space. Log-uniform ranges use positive lower bounds.",
  "shared": {
    "learning_rate": {
      "type": "loguniform",
      "low": 0.005,
      "high": 0.1
    },
    "max_depth": {
      "type": "logint",
      "low": 4,
      "high": 10
    },
    "min_child_weight": {
      "type": "loguniform",
      "low": 0.001,
      "high": 5.0
    },
    "subsample": {
      "type": "uniform",
      "low": 0.6,
      "high": 1.0
    },
    "colsample_bytree": {
      "type": "uniform",
      "low": 0.6,
      "high": 1.0
    },
    "n_estimators": {
      "type": "choice",
      "values": [200, 400, 600, 800]
    },
    "max_bin": {
      "type": "choice",
      "values": [255]
    }
  },
  "xgb_cpu": {
    "reg_lambda": {
      "type": "loguniform",
      "low": 0.001,
      "high": 10.0
    }
  },
  "current_metagb": {
    "metagb_lambda_l2": {
      "type": "choice",
      "values": [1.0]
    },
    "metagb_score_agg": {
      "type": "choice",
      "values": [0]
    }
  }
}
