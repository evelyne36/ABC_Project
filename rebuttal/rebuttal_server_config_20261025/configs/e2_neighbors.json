  "regression_datasets": [
    "kin8nm",
    "moneyball",
    "cpu_activity",
    "houses",
    "energy_efficiency"
  ],
  "optional_binary_datasets": [
    "ilpd",
    "phoneme",
    "credit_approval"
  ],
  "sampling_scope": "diagnostic cases selected from already-reported wins/losses; not population win-rate estimate",
  "default_models": [
    "xgb",
    "crossgb",
    "lgbm_constant",
    "lgbm_linear"
  ],
  "original_neighbor_candidates": [
