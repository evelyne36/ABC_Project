      "high": 1.0
    },
    "n_estimators": {
      "distribution": "choice",
      "values": [
        200,
        400,
        600,
        800
      ]
    },
    "max_bin": {
      "distribution": "choice",
      "values": [
        255
      ]
    },
    "lambda_l2": {
      "distribution": "loguniform",
      "low": 0.0001,
      "high": 5.0
    }
  },
  "crossgb_private": {
    "pred_fraction": {
      "values": [
        0.1,
        0.2,
        0.4,
