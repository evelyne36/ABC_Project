    "n_jobs": 1
  },
  "lgbm_private": {
    "num_leaves": [
      15,
      31,
      63,
      127
    ],
    "min_child_samples": [
      1,
      5,
      20,
      50
    ],
    "linear_tree_values_by_model": {
      "lgbm_constant": false,
      "lgbm_linear": true
    },
    "linear_lambda": {
      "distribution": "loguniform",
      "low": 0.0001,
      "high": 100.0
    },
    "n_jobs": 1
  },
  "preprocessing": {
    "row_filter": "match original eligible-row order",
    "encoding": "OneHotEncoder trained separately inside each inner/outer train",
    "unknown_categories": "ignore",
    "linear_tree_scaling": "fit StandardScaler only on current training data",
    "new_lgbm_Dataset_per_linear_tree_setting": true
  },
  "selection": {
    "metric": "RMSE minimize; AUC maximize for optional binary",
